// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
    {
        "label": "PHP: Listen to Xdebug (Docker)",
        "adapter": "Xdebug",
        "request": "launch",
        "port": 9003,
        "pathMappings": {
            "/var/www/html": "$ZED_WORKTREE_ROOT",
        },
        "hostname": "0.0.0.0",
        "xdebugSettings": {
            "max_data": 65535,
            "show_hidden": 1,
            "max_children": 100,
            "max_depth": 5,
        },
    },
]
